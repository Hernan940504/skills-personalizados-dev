# Plantilla de configuración de un proyecto Langfuse.
# Copia esta carpeta a proyectos/<tu-proyecto>/ y completa los valores.
# Las llaves se obtienen en Langfuse: Settings -> API Keys.
# Mantén las comillas: protegen valores con caracteres especiales.

# Host de Langfuse (cloud o self-hosted). Sin slash final.
LANGFUSE_HOST="https://cloud.langfuse.com"

# Public key (no sensible).
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# El SECRET NO va aquí. Ponlo en un archivo hermano 'secret.env' (gitignored):
#   LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# o expórtalo en tu shell antes de correr el script.
