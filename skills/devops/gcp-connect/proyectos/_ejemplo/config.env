# Plantilla de configuración por proyecto de GCP.
# Copia esta carpeta como proyectos/<nombre>/ y completa los valores,
# o corre `gcp-connect.sh <nombre>` para descubrirlos automáticamente.

# ID del proyecto de GCP (obligatorio). Ej: mi-empresa-prod-1234
PROJECT_ID=

# Cuenta de Google con la que te conectas (opcional; por defecto la activa).
# Ej: hernan@miempresa.com
ACCOUNT=

# Nombre de la configuración de gcloud (opcional; por defecto = nombre de la carpeta).
# Solo minúsculas, dígitos y guiones; debe empezar por letra.
CONFIG_NAME=

# Región y zona de cómputo por defecto (opcional). Ej: us-central1 / us-central1-a
REGION=
ZONE=

# Ruta ABSOLUTA al JSON de una service account (opcional).
# Si se define y el archivo existe, se activa la SA en vez de pedir login de usuario.
# NO commitear el archivo de llaves al repositorio.
KEY_FILE=
