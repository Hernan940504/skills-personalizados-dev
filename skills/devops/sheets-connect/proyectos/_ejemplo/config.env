# Plantilla de configuración por proyecto para sheets-connect.
# Copia esta carpeta a proyectos/<tu-proyecto>/ y completa los valores.

# Email de la service account que accede a los sheets.
# El o los spreadsheets deben compartirse con este email desde Google Drive.
SA_EMAIL=sheets-connect@<project-id>.iam.gserviceaccount.com

# Modo de autenticación: "impersonate", "key" o "user-oauth".
#  - impersonate: requiere roles/iam.serviceAccountTokenCreator sobre la SA. No descarga llaves.
#  - key: usa una llave JSON de la SA (secreto de larga vida). Ruta en KEY_FILE.
#  - user-oauth: usa TU identidad de usuario con un OAuth Client ID propio (Desktop).
#       Útil cuando la política de la organización impide compartir archivos con la SA.
AUTH_MODE=key

# Solo para AUTH_MODE=key: ruta ABSOLUTA a la llave JSON, FUERA del repo.
# Ejemplo: /Users/tu-usuario/.config/gcloud/sheets-connect-sa@<project-id>.json
KEY_FILE=

# Solo para AUTH_MODE=user-oauth: ruta al client secret JSON descargado de la consola
# (Credenciales > OAuth client ID > Desktop app), FUERA del repo.
OAUTH_CLIENT_FILE=
# Cache del token de usuario (se crea solo tras el primer login). FUERA del repo.
OAUTH_TOKEN_FILE=

# Proyecto GCP (para quota / referencia). Opcional.
PROJECT_ID=<project-id>
