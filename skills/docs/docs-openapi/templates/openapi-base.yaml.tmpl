openapi: "3.0.3"

info:
  title: "{{API_TITLE}}"
  description: |
    {{API_DESCRIPTION}}

    ## Autenticación
    {{AUTH_DESCRIPTION}}
  version: "{{API_VERSION}}"
  contact:
    name: "{{CONTACT_NAME}}"
    email: "{{CONTACT_EMAIL}}"
  license:
    name: "MIT"

servers:
  - url: "http://localhost:{{PORT}}{{BASE_PATH}}"
    description: "Desarrollo local"
  - url: "https://{{STAGING_HOST}}{{BASE_PATH}}"
    description: "Staging"
  - url: "https://{{PROD_HOST}}{{BASE_PATH}}"
    description: "Producción"

# ─────────────────────────────────────────────────────────────────────────────
# TAGS — agrupación de endpoints en Swagger UI
# ─────────────────────────────────────────────────────────────────────────────
tags:
  - name: "{{TAG_1}}"
    description: "{{TAG_1_DESCRIPTION}}"
  - name: "{{TAG_2}}"
    description: "{{TAG_2_DESCRIPTION}}"

# ─────────────────────────────────────────────────────────────────────────────
# PATHS — endpoints de la API
# ─────────────────────────────────────────────────────────────────────────────
paths:
  /{{resource}}:
    get:
      tags: ["{{TAG_1}}"]
      summary: "Lista todos los {{resource}}"
      description: "Retorna una lista paginada de {{resource}}."
      operationId: "list{{Resource}}"
      parameters:
        - $ref: "#/components/parameters/PageParam"
        - $ref: "#/components/parameters/SizeParam"
      responses:
        "200":
          description: "Lista obtenida exitosamente"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{Resource}}ListResponse"
              example:
                data:
                  - id: 1
                    name: "ejemplo"
                pagination:
                  page: 1
                  size: 20
                  total: 100
        "401":
          $ref: "#/components/responses/Unauthorized"
        "500":
          $ref: "#/components/responses/InternalServerError"

    post:
      tags: ["{{TAG_1}}"]
      summary: "Crea un nuevo {{resource}}"
      operationId: "create{{Resource}}"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Create{{Resource}}Request"
            example:
              name: "nuevo recurso"
      responses:
        "201":
          description: "Creado exitosamente"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{Resource}}Response"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/UnprocessableEntity"
        "500":
          $ref: "#/components/responses/InternalServerError"

  /{{resource}}/{id}:
    parameters:
      - $ref: "#/components/parameters/IdParam"

    get:
      tags: ["{{TAG_1}}"]
      summary: "Obtiene un {{resource}} por ID"
      operationId: "get{{Resource}}ById"
      responses:
        "200":
          description: "Recurso encontrado"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{Resource}}Response"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "404":
          $ref: "#/components/responses/NotFound"
        "500":
          $ref: "#/components/responses/InternalServerError"

    put:
      tags: ["{{TAG_1}}"]
      summary: "Actualiza un {{resource}} completo"
      operationId: "update{{Resource}}"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Update{{Resource}}Request"
      responses:
        "200":
          description: "Actualizado exitosamente"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/{{Resource}}Response"
        "400":
          $ref: "#/components/responses/BadRequest"
        "404":
          $ref: "#/components/responses/NotFound"

    delete:
      tags: ["{{TAG_1}}"]
      summary: "Elimina un {{resource}}"
      operationId: "delete{{Resource}}"
      responses:
        "204":
          description: "Eliminado exitosamente"
        "404":
          $ref: "#/components/responses/NotFound"
        "500":
          $ref: "#/components/responses/InternalServerError"

# ─────────────────────────────────────────────────────────────────────────────
# COMPONENTS
# ─────────────────────────────────────────────────────────────────────────────
components:

  # ── Parámetros reutilizables ──────────────────────────────────────────────
  parameters:
    IdParam:
      name: id
      in: path
      required: true
      description: "Identificador único del recurso"
      schema:
        type: integer
        format: int64
        example: 1

    PageParam:
      name: page
      in: query
      required: false
      description: "Número de página (base 1)"
      schema:
        type: integer
        minimum: 1
        default: 1

    SizeParam:
      name: size
      in: query
      required: false
      description: "Cantidad de elementos por página"
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20

  # ── Respuestas reutilizables ──────────────────────────────────────────────
  responses:
    BadRequest:
      description: "Solicitud inválida — campos faltantes o con formato incorrecto"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            code: "VALIDATION_ERROR"
            message: "El campo 'email' no tiene un formato válido"
            details:
              - field: "email"
                issue: "invalid_format"

    Unauthorized:
      description: "No autenticado — token ausente o inválido"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            code: "UNAUTHORIZED"
            message: "Token de acceso inválido o expirado"

    Forbidden:
      description: "Acceso denegado — sin permisos suficientes"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"

    NotFound:
      description: "Recurso no encontrado"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            code: "NOT_FOUND"
            message: "El recurso solicitado no existe"

    UnprocessableEntity:
      description: "Entidad no procesable — datos semánticamente incorrectos"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"

    InternalServerError:
      description: "Error interno del servidor"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            code: "INTERNAL_ERROR"
            message: "Ocurrió un error inesperado"

  # ── Schemas ───────────────────────────────────────────────────────────────
  schemas:
    ErrorResponse:
      type: object
      required: [code, message]
      properties:
        code:
          type: string
          description: "Código de error legible por máquina"
          example: "NOT_FOUND"
        message:
          type: string
          description: "Descripción del error legible por humanos"
          example: "El recurso no fue encontrado"
        details:
          type: array
          description: "Errores de validación por campo (solo en 400/422)"
          items:
            type: object
            properties:
              field:
                type: string
              issue:
                type: string

    {{Resource}}Response:
      type: object
      required: [id]
      properties:
        id:
          type: integer
          format: int64
          description: "Identificador único"
          example: 1
        # Añadir propiedades del recurso aquí

    Create{{Resource}}Request:
      type: object
      required: []  # Listar campos obligatorios
      properties:
        # Añadir propiedades del request aquí

    Update{{Resource}}Request:
      type: object
      properties:
        # Añadir propiedades actualizables aquí

    {{Resource}}ListResponse:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: "#/components/schemas/{{Resource}}Response"
        pagination:
          $ref: "#/components/schemas/PaginationMeta"

    PaginationMeta:
      type: object
      properties:
        page:
          type: integer
          example: 1
        size:
          type: integer
          example: 20
        total:
          type: integer
          example: 150
        totalPages:
          type: integer
          example: 8

  # ── Security schemes ──────────────────────────────────────────────────────
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: "Token JWT. Obtenerlo en POST /auth/login"

    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key

# Aplicar BearerAuth a todos los endpoints por defecto
# (comentar si la API es pública)
security:
  - BearerAuth: []
