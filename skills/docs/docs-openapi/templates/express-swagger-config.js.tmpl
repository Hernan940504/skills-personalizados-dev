// src/swagger.js (o swagger.ts) — Configuración de swagger-jsdoc + swagger-ui-express
// Importar y registrar en app.js/server.js: setupSwagger(app)

const swaggerJsdoc = require('swagger-jsdoc');
const swaggerUi = require('swagger-ui-express');

const swaggerDefinition = {
  openapi: '3.0.3',
  info: {
    title: '{{API_TITLE}}',
    version: '{{API_VERSION}}',
    description: '{{API_DESCRIPTION}}',
    contact: {
      name: '{{CONTACT_NAME}}',
      email: '{{CONTACT_EMAIL}}',
    },
    license: {
      name: 'MIT',
    },
  },
  servers: [
    {
      url: 'http://localhost:{{PORT}}',
      description: 'Desarrollo local',
    },
    {
      url: 'https://{{STAGING_URL}}',
      description: 'Staging',
    },
  ],
  components: {
    securitySchemes: {
      BearerAuth: {
        type: 'http',
        scheme: 'bearer',
        bearerFormat: 'JWT',
        description: 'Token JWT. Obtenerlo en POST /api/v1/auth/login',
      },
    },
    // Los schemas se definen inline en los JSDoc de cada archivo de ruta
    // o se pueden centralizar aquí:
    schemas: {
      ErrorResponse: {
        type: 'object',
        required: ['code', 'message'],
        properties: {
          code: { type: 'string', example: 'NOT_FOUND' },
          message: { type: 'string', example: 'El recurso no fue encontrado' },
        },
      },
    },
  },
  security: [{ BearerAuth: [] }],
};

const options = {
  swaggerDefinition,
  // Rutas de archivos que contienen JSDoc con @swagger
  // Ajustar según la estructura del proyecto
  apis: [
    './src/routes/**/*.js',
    './src/routes/**/*.ts',
    './src/controllers/**/*.js',
    './src/controllers/**/*.ts',
  ],
};

const swaggerSpec = swaggerJsdoc(options);

function setupSwagger(app) {
  // Swagger UI
  app.use('/api-docs', swaggerUi.serve, swaggerUi.setup(swaggerSpec, {
    swaggerOptions: {
      persistAuthorization: true,
      tagsSorter: 'alpha',
      operationsSorter: 'method',
    },
    customSiteTitle: '{{API_TITLE}} — Swagger UI',
  }));

  // Spec en JSON
  app.get('/api-docs.json', (req, res) => {
    res.setHeader('Content-Type', 'application/json');
    res.send(swaggerSpec);
  });

  console.log('Swagger UI disponible en: http://localhost:{{PORT}}/api-docs');
}

module.exports = { setupSwagger, swaggerSpec };
