import { type Page, type Locator, expect } from '@playwright/test';

/**
 * Page Object del módulo "{{MODULE_NAME}}".
 * Encapsula locators y acciones para que los specs lean como lenguaje de negocio.
 *
 * Reglas:
 *  - Locators orientados al usuario: getByRole / getByLabel / getByText / getByTestId.
 *  - Nada de selectores frágiles (clases CSS auto-generadas, nth() sin filter()).
 *  - Las aserciones web-first viven en métodos `assert*` o en el spec.
 */
export class {{MODULE_CLASS}}Page {
  readonly page: Page;

  // --- Locators (ajústalos con lo descubierto en la fase de exploración) ---
  private readonly heading: Locator;
  private readonly primaryAction: Locator;

  constructor(page: Page) {
    this.page = page;
    this.heading = page.getByRole('heading', { name: /{{MODULE_NAME}}/i });
    this.primaryAction = page.getByRole('button', { name: /{{PRIMARY_ACTION}}/i });
  }

  /** Navega directamente al módulo (baseURL viene de la config). */
  async goto(): Promise<void> {
    await this.page.goto('{{MODULE_PATH}}');
    await this.assertLoaded();
  }

  /** Verifica que el módulo cargó (señal estable de la pantalla). */
  async assertLoaded(): Promise<void> {
    await expect(this.heading).toBeVisible();
  }

  // --- Acciones de negocio (ejemplos a completar) -------------------------
  async {{ACTION_METHOD}}(): Promise<void> {
    await this.primaryAction.click();
  }
}
