# =====================================================================
# Plantilla de credenciales — COPIA a `.env` y rellena. NO commitees `.env`.
#   cp .env.example .env
# =====================================================================

# URL base del portal bajo prueba (con / final).
ARKAN_BASE_URL=https://arkan.bolnet.com.co/

# Credenciales del usuario de prueba.
ARKAN_USER=tu.usuario@empresa.com
ARKAN_PASSWORD=

# Selectores del formulario de login. Déjalos vacíos para usar la estrategia
# accesible por defecto (getByLabel / getByRole). Rellénalos solo si el login
# no expone labels accesibles y necesitas CSS/XPath explícitos.
ARKAN_LOGIN_USER_SELECTOR=
ARKAN_LOGIN_PASSWORD_SELECTOR=
ARKAN_LOGIN_SUBMIT_SELECTOR=

# Selector que SOLO existe cuando ya estás autenticado (señal de éxito de login).
ARKAN_LOGGED_IN_SELECTOR=
